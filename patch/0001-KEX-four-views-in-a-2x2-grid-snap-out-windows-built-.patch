-	//Platform::DebugPrintf("ScrollInfo %d mask=%x min=%d max=%d page=%d pos=%d track=%d\n", b,sci.fMask,
-	//sci.nMin, sci.nMax, sci.nPage, sci.nPos, sci.nTrackPos);
-	Sci::Line topLineNew = topLine;
