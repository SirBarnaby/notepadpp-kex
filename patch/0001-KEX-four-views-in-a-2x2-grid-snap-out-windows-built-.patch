+void Editor::HorizontalScrollTo(int xPos) {
+	//Platform::DebugPrintf("HorizontalScroll %d\n", xPos);
+	if (xPos < 0)
+		xPos = 0;
+	if (!Wrapping() && (xOffset != xPos)) {
+		xOffset = xPos;
+		ContainerNeedsUpdate(Update::HScroll);
+		SetHorizontalScrollPos();
+		RedrawRect(GetClientRectangle());
+	}
+}
