+HRESULT ScintillaWin::KexGlassCreate() noexcept {
+	using CreateDevice2Sig = HRESULT (WINAPI *)(IUnknown *, REFIID, void **);
+	static const CreateDevice2Sig createDevice2 = [] {
+		const HMODULE dcomp = ::LoadLibraryExW(L"dcomp.dll", {}, LOAD_LIBRARY_SEARCH_SYSTEM32);
+		return dcomp ? DLLFunction<CreateDevice2Sig>(dcomp, "DCompositionCreateDevice2") : nullptr;
+	}();
+	if (!createDevice2)
+		return HRESULT_FROM_WIN32(ERROR_PROC_NOT_FOUND);
+	kexLayer.Release();
+	HRESULT hr = Create3D();	// the Direct2D device the layer is drawn with
+	if (FAILED(hr))
+		return hr;
+	hr = createDevice2(device.pDirect2DDevice.Get(), __uuidof(IDCompositionDesktopDevice),
+		reinterpret_cast<void **>(kexLayer.device.GetAddressOf()));
+	if (FAILED(hr))
+		return hr;
+	// not topmost: above what the window draws itself, below any child windows
+	hr = kexLayer.device->CreateTargetForHwnd(MainHWND(), FALSE, kexLayer.target.GetAddressOf());
+	if (SUCCEEDED(hr))
+		hr = kexLayer.device->CreateVisual(kexLayer.visual.GetAddressOf());
+	UINT width = 1;
+	UINT height = 1;
+	KexGlassSize(width, height);
+	if (SUCCEEDED(hr))
+		hr = kexLayer.device->CreateVirtualSurface(width, height, DXGI_FORMAT_B8G8R8A8_UNORM, DXGI_ALPHA_MODE_PREMULTIPLIED,
