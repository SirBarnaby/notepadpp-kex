+	if (rcClip.left < rcClip.right && rcClip.top < rcClip.bottom)
+		surface->PopClip();
+	if (kexStats.carets > 0)
+		++kexStats.frames;
+
+	int ms = 0;
+	if (kexStats.carets > 0) {
+		if (gliding || nextBlink == 0)
+			ms = 15;
+		else if (nextBlink > 0)
+			ms = static_cast<int>(nextBlink) + 1;
+	}
+	if (ms > 0)
+		FineTickerStart(TickReason::kexCaret, ms, 0);
+	else
+		FineTickerCancel(TickReason::kexCaret);
+	kexStats.workMs += KexNowMs() - now;
+}
+
+// Scintilla's own carets (the smooth caret off), recorded instead of painted into a motion's picture: held back
+// as they are, blinking as Scintilla's own (a block one shows the character through it, as the smooth one does).
+void Editor::KexHoldStockCarets() {
+	const bool on = caret.active && caret.on;
+	const XYPOSITION top = static_cast<XYPOSITION>(topLine) * vs.lineHeight;
+	for (const KexCaretTarget &t : view.kexSeen) {
+		if (t.blinks && !on)
+			continue;
+		const XYPOSITION x = t.x + vs.textStart - xOffset;
+		kexCaretsHeld.push_back({ PRectangle(x, t.y - top, x + t.w, t.y - top + t.h), ColourRGBA(t.colour, t.block ? 140 : 255), t.main });
+	}
+}
+
+// The carets held back from a motion's picture, on top of the frame put together from it.
+void Editor::KexDrawHeldCarets(Surface *surfaceWindow) {
+	kexCaretsLater = false;
+	if (kexCaretsHeld.empty())
+		return;
+	surfaceWindow->SetClip(GetTextRectangle());
+	for (const KexHeldCaret &c : kexCaretsHeld) {
+		surfaceWindow->FillRectangle(c.rc, Fill(c.colour));
+		if (c.main && kexSlideDir == 4)
+			kexMotionStats.caretX = static_cast<float>(c.rc.left);	// where the main caret showed in the motion
+	}
+	surfaceWindow->PopClip();
+	kexCaretsHeld.clear();
+}
+
+// Repaint where carets were drawn and where they are now, so the next paint draws the next frame.
+void Editor::KexInvalidate() {
+	const bool stale = kexPictureStale;	// the carets alone: a motion's picture holds none
+	const double now = KexNowMs();
+	for (const PRectangle &rc : kexOnScreen)
+		RedrawRect(PRectangle(rc.left - 1, rc.top - 1, rc.right + 1, rc.bottom + 1));
+	kexOnScreen.clear();
+	for (const KexCaret &c : kexCarets) {
+		if (!c.valid)
+			continue;
+		const KexCaretTarget t = KexCurrent(c, now);
+		const XYPOSITION x = t.x + vs.textStart - xOffset;
+		const XYPOSITION y = t.y - static_cast<XYPOSITION>(topLine) * vs.lineHeight;
+		RedrawRect(PRectangle(x - 1, y - 1, x + t.w + 1, y + t.h + 1));
+	}
+	kexPictureStale = stale;
+}
+
+// ---- KEX tab slide (KexScintilla.h) ----
+
+// Where this paint draws: straight on screen, or into a picture that is put on screen afterwards.
+Editor::KexTarget Editor::KexPaintTarget(Surface *surfaceWindow, PRectangle rcArea, PRectangle rcClient, Surface **target, PRectangle *area) {
+	const int width = static_cast<int>(rcClient.Width()), height = static_cast<int>(rcClient.Height());
+	if (width <= 0 || height <= 0) {
+		if (kexSlideOld || kexSlideCapture)
+			KexEndSlide(true, 1);
+		return KexTarget::direct;
+	}
+	// the view may change size as the new document comes in (a scroll bar shows or goes): each picture
+	// keeps the size it was painted at
+	if (kexSlideCapture) {
+		kexSlideOld = surfaceWindow->AllocatePixMap(width, height);
+		kexOldWidth = width;
+		kexOldHeight = height;
+		if (!kexSlideOld || !kexSlideOld->Initialised()) {
+			KexEndSlide(true, 2);
+			return KexTarget::direct;
+		}
+		*target = kexSlideOld.get();
+		*area = rcClient;
+		return KexTarget::capture;
+	}
+	if (kexSlideOld && kexSlideDir) {
+		if (!(kexSlideNew && kexSlideNew->Initialised() && kexNewWidth == width && kexNewHeight == height)) {
+			kexSlideNew = surfaceWindow->AllocatePixMap(width, height);
+			kexNewWidth = width;
+			kexNewHeight = height;
+			kexPictureStale = true;
+		}
+		if (!kexSlideNew || !kexSlideNew->Initialised()) {
+			KexEndSlide(true, 3);
+			return KexTarget::direct;
+		}
+		if (kexSlideStart < 0) {
+			kexSlideStart = KexNowMs();
+			++kexSlideStats.slides;
+			if (kexSlideHeld < 0)
+				FineTickerStart(TickReason::kexSlide, 15, 0);
+		}
+		*target = kexSlideNew.get();
+		*area = rcClient;
+		return KexTarget::slide;
+	}
+	if (kexOn && technology == Technology::Default) {
+		// GDI: the text and the caret reach the screen in one copy, so no frame shows the text without its caret
+		if (!(kexFrame && kexFrame->Initialised() && kexFrameWidth == width && kexFrameHeight == height)) {
+			kexFrame = surfaceWindow->AllocatePixMap(width, height);
+			kexFrameWidth = width;
+			kexFrameHeight = height;
+		}
+		if (kexFrame && kexFrame->Initialised()) {
+			*target = kexFrame.get();
+			*area = rcArea;
+			return KexTarget::frame;
+		}
+	}
+	return KexTarget::direct;
+}
+
+void Editor::KexPresent(KexTarget mode, Surface *surfaceWindow, Surface *target, PRectangle rcArea, PRectangle rcClient) {
+	if (mode == KexTarget::direct || target == surfaceWindow)
+		return;
+	target->FlushDrawing();
+	if (mode == KexTarget::frame) {
+		surfaceWindow->Copy(rcArea, Point(rcArea.left, rcArea.top), *target);
+		return;
+	}
+	if (mode == KexTarget::capture) {
+		// the old picture is taken; the screen keeps showing it until the new document is painted
+		surfaceWindow->Copy(rcClient, Point(rcClient.left, rcClient.top), *target);
+		KexDrawHeldCarets(surfaceWindow);
+		kexSlideCapture = false;
+		kexSlideStart = -1;
+		++kexSlideStats.captures;
+		return;
+	}
+	if (kexSlideDir == 4) {
+		KexPresentMotion(surfaceWindow, rcClient);
+		KexDrawHeldCarets(surfaceWindow);
+		return;
+	}
+	// slide: the old picture moves out, the new one follows it in
+	const bool held = kexSlideHeld >= 0;
+	double f = held ? kexSlideHeld : kexSlideMs > 0 ? (KexNowMs() - kexSlideStart) / kexSlideMs : 1.0;
+	if (kexSlideFreeze >= 0 && f > kexSlideFreeze)
+		f = kexSlideFreeze;
+	f = std::clamp(f, 0.0, 1.0);
+	// held: straight where it is put (the fingers' movement is the curve), otherwise ease-out
+	const double e = held ? f : 1.0 - (1.0 - f) * (1.0 - f) * (1.0 - f);
+	const XYPOSITION width = rcClient.Width();
+	if (kexSlideDir == 2) {
+		// fade (a tab closed): the new document is in place and the old picture fades out over it, shrinking a little
+		kexSlideStats.lastFraction = static_cast<float>(f);
+		++kexSlideStats.frames;
+		const PRectangle rcNew(rcClient.left, rcClient.top, std::min<XYPOSITION>(rcClient.right, rcClient.left + kexNewWidth),
+			std::min<XYPOSITION>(rcClient.bottom, rcClient.top + kexNewHeight));
+		if (rcNew.Width() > 0 && rcNew.Height() > 0)
+			surfaceWindow->Copy(rcNew, Point(0, 0), *kexSlideNew);
+		const float opacity = static_cast<float>(1.0 - e);
+		IKexSurface *kex = dynamic_cast<IKexSurface *>(surfaceWindow);
+		if (kex && opacity > 0.004f) {
+			const XYPOSITION scale = 1.0 - 0.025 * e;
+			const XYPOSITION w = kexOldWidth * scale, h = kexOldHeight * scale;
+			const XYPOSITION x = rcClient.left + (kexOldWidth - w) / 2, y = rcClient.top + (kexOldHeight - h) / 2;
+			kex->KexDrawPicture(PRectangle(x, y, x + w, y + h), *kexSlideOld,
+				PRectangle(0, 0, static_cast<XYPOSITION>(kexOldWidth), static_cast<XYPOSITION>(kexOldHeight)), opacity);
+		}
+		if (f >= 1.0 && !held)
+			KexEndSlide(false);
+		return;
+	}
+	const XYPOSITION shift = std::round(static_cast<XYPOSITION>(e) * width);
+	const XYPOSITION xOld = rcClient.left - kexSlideDir * shift;
+	const XYPOSITION xNew = xOld + kexSlideDir * width;
+	kexSlideStats.lastFraction = static_cast<float>(f);
+	++kexSlideStats.frames;
+	auto put = [&](Surface &pic, XYPOSITION x, int w, int h) {
+		const PRectangle rc(std::max(rcClient.left, x), rcClient.top, std::min({ rcClient.right, x + width, x + w }),
+			std::min(rcClient.bottom, rcClient.top + h));
+		if (rc.Width() > 0 && rc.Height() > 0)
+			surfaceWindow->Copy(rc, Point(rc.left - x, rc.top - rcClient.top), pic);
+	};
+	if (kexOldWidth < width || kexOldHeight < rcClient.Height()) {
+		// the old picture is smaller than the view now: the rest of its place gets the background
+		const ColourRGBA back = vs.styles[StyleDefault].back;
+		const PRectangle right(std::max(rcClient.left, xOld + kexOldWidth), rcClient.top, std::min(rcClient.right, xOld + width), rcClient.bottom);
+		const PRectangle below(std::max(rcClient.left, xOld), rcClient.top + kexOldHeight, std::min(rcClient.right, xOld + std::min<XYPOSITION>(width, kexOldWidth)), rcClient.bottom);
+		if (right.Width() > 0 && right.Height() > 0)
+			surfaceWindow->FillRectangle(right, back);
+		if (below.Width() > 0 && below.Height() > 0)
+			surfaceWindow->FillRectangle(below, back);
+	}
+	put(*kexSlideOld, xOld, kexOldWidth, kexOldHeight);
+	put(*kexSlideNew, xNew, kexNewWidth, kexNewHeight);
+	if (f >= 1.0 && !held)
+		KexEndSlide(false);
+}
+
+// SCI_KEX_SLIDE: take the picture of what the view shows now (the platform paints it at once)
+bool Editor::KexStartSlide(int direction, int ms) {
+	KexEndSlide(false);
+	const PRectangle rcClient = GetClientRectangle();
+	if (!wMain.GetID() || rcClient.Width() < 1 || rcClient.Height() < 1)
+		return false;
+	kexSlideDir = direction;
+	kexSlideMs = std::clamp(ms, 1, 2000);
+	kexSlideHeld = ms == 0 ? 0.0 : -1.0;
+	kexSlideCapture = true;
+	kexSlideStart = -1;
+	Redraw();
+	return true;
+}
+
+// ---- KEX motion (KexScintilla.h, SCI_KEX_SETMOTIONS) ----
+
+namespace {
+
+// a critically damped spring from rest (no bounce), settled to 0.5 % at u = 1
+double KexSpring(double u) noexcept {
+	if (u <= 0)
+		return 0;
+	if (u >= 1)
+		return 1;
+	return 1.0 - (1.0 + 7.43 * u) * std::exp(-7.43 * u);
+}
+
+double KexEaseOut(double t) noexcept {
+	t = std::clamp(t, 0.0, 1.0);
+	return 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
+}
+
+// the light on new text: up in 50 ms, then fading out over the rest of ms
+double KexLight(double t, double ms) noexcept {
+	if (ms <= 0 || t >= ms)
+		return 0;
+	if (t < 50)
+		return t / 50;
+	return 1.0 - (t - 50) / std::max(1.0, ms - 50);
+}
+
+// the lines of a block of text, without their line ends; a line end at the very end makes no extra line
+std::vector<std::string> KexSplitLines(std::string_view text) {
+	std::vector<std::string> lines;
+	size_t from = 0;
+	while (from < text.size()) {
+		size_t end = text.find_first_of("\r\n", from);
+		if (end == std::string_view::npos)
+			end = text.size();
+		lines.emplace_back(text.substr(from, end - from));
+		from = end;
+		if (from < text.size() && text[from] == '\r')
+			++from;
+		if (from < text.size() && text[from] == '\n')
+			++from;
+	}
+	return lines;
+}
+
+constexpr bool KexIsEdit(int kind) noexcept {
+	return kind == KEXM_CUT || kind == KEXM_DELETE || kind == KEXM_DELETELINES || kind == KEXM_PASTE ||
+		kind == KEXM_UNDO || kind == KEXM_DUPLICATE;
+}
+
+}
+
+bool Editor::KexMotionOn(KexMotionKind kind) const noexcept {
+	const int k = static_cast<int>(kind);
+	return k >= 0 && k < KEXM_COUNT && kexMotions.ms[k] > 0;
+}
+
+// The edit is about to start: picture the view as it is now (painted at once). False: no motion this time.
+bool Editor::KexMotionBegin(KexMotionKind kind) {
+	if (!KexMotionOn(kind) || kexMotion.open || paintState != PaintState::notPainting)
+		return false;
+	if (kexMotionHold) {
+		++kexMotionStats.refused;	// one of several edits in one go (fold all, a macro): none until the view paints
+		return false;
+	}
+	const double now = KexNowMs();
+	const bool rapid = now - kexMotionLast < kexMotions.rapidMs;
+	kexMotionLast = now;
+	const bool busy = kexSlideOld || kexSlideCapture;
+	if (rapid || (busy && kexSlideDir != 4) || (busy && !kexMotion.started)) {
+		// editing fast, several edits in one go, or a tab slide on its way: none, and the view shows what is
+		if (busy && kexSlideDir == 4) {
+			KexEndSlide(true, 8);
+			Redraw();
+		}
+		if (busy && !rapid)
+			kexMotionHold = true;
+		if (rapid)
+			++kexMotionStats.skipped;
+		else
+			++kexMotionStats.refused;
+		return false;
+	}
+	const PRectangle rcClient = GetClientRectangle();
+	if (!wMain.GetID() || rcClient.Width() < 1 || rcClient.Height() < 1)
+		return false;
+	if (busy)
+		KexEndSlide(false);	// the last motion jumps to its end
+	kexMotion = KexMotionState();
+	kexMotion.kind = kind;
+	kexMotion.open = true;
+	kexPictureStale = true;
+	kexMotion.topLine = topLine;
+	kexMotion.xOffset = xOffset;
+	kexMotion.lineHeight = vs.lineHeight;
+	kexMotion.textLeft = vs.textStart;
+	const int k = static_cast<int>(kind);
+	int ms = std::clamp(kexMotions.ms[k], 1, 3000);
+	if (k == KEXM_PASTE || k == KEXM_UNDO || k == KEXM_DUPLICATE)
+		ms = std::max(ms, std::clamp(kexMotions.glowMs, 0, 3000));
+	else if (k == KEXM_JUMP)
+		ms = ms * 5 / 2;	// the slide, then the band on the caret's line
+	kexSlideDir = 4;
+	kexSlideMs = ms;
+	kexSlideHeld = -1;
+	kexSlideStart = -1;
+	kexSlideCapture = true;
+	Redraw();
+	if (!KexPaintNow() || kexSlideCapture) {
+		KexEndSlide(true, 6);	// nothing was painted (hidden, or drawing switched off)
+		kexMotion.open = false;
+		++kexMotionStats.refused;
+		return false;
+	}
+	return true;
+}
+
+// The edit is done: keep the motion only when the edit was one it can show.
+void Editor::KexMotionClose() {
+	KexMotionState &m = kexMotion;
+	m.open = false;
+	if (kexSlideDir != 4)
+		return;
+	bool ok = !m.refused;
+	switch (static_cast<int>(m.kind)) {
+	case KEXM_CUT:
+	case KEXM_DELETE:
+	case KEXM_DELETELINES:
+		ok = ok && m.start >= 0 && m.deleted > 0 && m.inserted == 0;
+		break;
+	case KEXM_PASTE:
+	case KEXM_DUPLICATE:
+		ok = ok && m.start >= 0 && m.inserted > 0;
+		break;
+	case KEXM_UNDO:
+		ok = ok && m.start >= 0 && (m.deleted > 0 || m.inserted > 0);
+		break;
+	case KEXM_MOVELINE:
+	case KEXM_INDENT:
+	case KEXM_SORT:
+		ok = ok && m.changed;
+		break;
+	default:
+		break;	// fold checks itself at its first frame
+	}
+	if (!ok) {
+		KexEndSlide(true, 9);
+		++kexMotionStats.refused;
+		Redraw();
+	}
+}
+
+// A change made by the edit while it runs: one place, text removed and/or put in there.
+void Editor::KexMotionRecord(const DocModification &mh) {
+	KexMotionState &m = kexMotion;
+	if (FlagSet(mh.modificationType, ModificationFlags::InsertText | ModificationFlags::DeleteText))
+		m.changed = true;
+	if (!KexIsEdit(static_cast<int>(m.kind)))
+		return;
+	if (FlagSet(mh.modificationType, ModificationFlags::BeforeDelete)) {
+		if (m.start < 0) {
+			// where the removed text is on screen, while the view still shows it
+			m.start = mh.position;
+			m.deleted = mh.length;
+			m.at = LocationFromPosition(mh.position);
+			m.oldEnd = LocationFromPosition(mh.position + mh.length);
+			m.atKnown = true;
+		} else if (m.inserted == 0 && mh.position + mh.length == m.start) {
+			// the text just before it goes too (undoing typing goes back character by character)
+			m.start = mh.position;
+			m.deleted += mh.length;
+			m.at = LocationFromPosition(mh.position);
+		} else {
+			m.refused = true;
+		}
+	} else if (FlagSet(mh.modificationType, ModificationFlags::InsertText)) {
+		if (m.start < 0) {
+			m.start = mh.position;
+			m.inserted = mh.length;
+		} else if (mh.position == m.start + m.inserted) {
+			m.inserted += mh.length;	// in the removed text's place, or the rest of what goes in
+		} else {
+			m.refused = true;
+		}
+	}
+}
+
+// The first frame, with the view as it is after the edit: where everything is now. False: the motion can't show it.
+bool Editor::KexMotionSize(KexMotionKind kind, int *rows) const noexcept {
+	*rows = 0;
+	switch (static_cast<int>(kind)) {
+	case KEXM_MOVELINE: {
+		// the moved lines and the line they pass, as they are now: all shown (not folded away); a wrapped line
+		// takes several rows and moves as one band (their rows are measured with the move, KexPresentMotion)
+		const Sci::Line from = kexMotion.lineFrom + std::min(0, kexMotion.lineDelta);
+		const Sci::Line to = kexMotion.lineTo + std::max(0, kexMotion.lineDelta);
+		if (from < 0 || to > pdoc->LinesTotal() || from >= to)
+			return false;
+		for (Sci::Line line = from; line < to; ++line) {
+			if (!pcs->GetVisible(line))
+				return false;
+		}
+		return true;
+	}
+	case KEXM_INDENT:
+	case KEXM_SORT:
+		// line by line: every line one row on screen (word wrap may be on, as long as these lines don't wrap)
+		for (Sci::Line line = kexMotion.lineFrom; line < kexMotion.lineTo; ++line) {
+			if (!pcs->GetVisible(line) || pcs->GetHeight(line) != 1)
+				return false;
+		}
+		*rows = static_cast<int>(kexMotion.lineTo - kexMotion.lineFrom);
+		return *rows > 0;
+	default:
+		return true;
+	}
+}
+
+void Editor::KexPresentMotion(Surface *surfaceWindow, PRectangle rcClient) {
+	KexMotionState &m = kexMotion;
+	double t = KexNowMs() - kexSlideStart;
+	if (kexSlideFreeze >= 0)
+		t = std::min(t, kexSlideFreeze * kexSlideMs);
+	t = std::clamp(t, 0.0, static_cast<double>(kexSlideMs));
+	kexMotionStats.fraction = static_cast<float>(kexSlideMs > 0 ? t / kexSlideMs : 1.0);
+	kexSlideStats.lastFraction = kexMotionStats.fraction;
+	const XYPOSITION W = std::min<XYPOSITION>(rcClient.right, kexNewWidth), H = std::min<XYPOSITION>(rcClient.bottom, kexNewHeight);
+	auto showNew = [&]() {
+		surfaceWindow->Copy(PRectangle(rcClient.left, rcClient.top, W, H), Point(0, 0), *kexSlideNew);
+	};
+	if (m.open) {
+		showNew();	// painted while the edit still runs: it goes on once the edit is done
+		kexSlideStart = -1;
+		return;
+	}
+	const int kind = static_cast<int>(m.kind);
+	if (!m.started && kind == KEXM_MOVELINE && topLine != m.topLine && xOffset == m.xOffset) {
+		// the view scrolled to keep the moved lines in sight (moved past its top or bottom edge): they start where they
+		// were, in the view as it is now (every frame is made from the new picture)
+		m.rowTop -= static_cast<XYPOSITION>(topLine - m.topLine) * vs.lineHeight;
+		m.topLine = topLine;
+	}
+	const bool scrolled = kind == KEXM_JUMP ? (m.started && topLine != m.jumpTo) : (topLine != m.topLine || xOffset != m.xOffset);
+	if (scrolled || kexNewWidth != kexOldWidth || kexNewHeight != kexOldHeight) {
+		showNew();
+		++(m.started ? kexMotionStats.ended : kexMotionStats.refused);
+		KexEndSlide(true, 10);
+		return;
+	}
+	if (!m.started) {
+		// where things are now
+		bool ok = true;
+		int rows = 0;
+		const XYPOSITION lh = m.lineHeight;
+		if (KexIsEdit(kind)) {
+			if (!m.atKnown) {
+				m.at = LocationFromPosition(m.start);
+				m.oldEnd = m.at;
+			}
+			m.newEnd = LocationFromPosition(m.start + m.inserted);
+			ok = m.at.y >= 0 && m.at.y < H && m.at.x < W && m.oldEnd.y >= m.at.y;
+			switch (kind) {
+			case KEXM_CUT: m.style = KexEditStyle::lift; break;
+			case KEXM_DELETE: m.style = m.oldEnd.y > m.at.y ? KexEditStyle::fade : KexEditStyle::wipe; break;
+			case KEXM_DELETELINES: m.style = KexEditStyle::fade; break;
+			case KEXM_PASTE: m.style = KexEditStyle::uncover; break;
+			case KEXM_UNDO: m.style = m.inserted > 0 ? KexEditStyle::uncover : KexEditStyle::fade; break;
+			case KEXM_DUPLICATE: {
+				// whole lines come out from under the line; part of a line is uncovered in place
+				const Sci::Position end = m.start + m.inserted;
+				const char first = pdoc->CharAt(m.start), last = pdoc->CharAt(end - 1);
+				const bool afterLine = first == '\r' || first == '\n';
+				const bool beforeLine = m.start == pdoc->LineStart(pdoc->SciLineFromPosition(m.start)) && (last == '\r' || last == '\n');
+				m.style = (afterLine || beforeLine) ? KexEditStyle::peel : KexEditStyle::uncover;
+				m.peelTop = std::round(m.at.y) + (afterLine ? lh : 0);
+				break;
+			}
+			default: break;
+			}
+			if (m.inserted > 0 && m.deleted > 0)
+				m.style = KexEditStyle::uncover;	// text replaced: the new text is uncovered where the old was
+		} else if (kind == KEXM_JUMP) {
+			m.jumpTo = topLine;
+		} else if (kind == KEXM_FOLD) {
+			const Sci::Line rowsNow = pcs->DisplayFromDoc(m.lineTo) - pcs->DisplayFromDoc(m.lineFrom + 1);
+			m.rowsMoved = std::abs(m.foldRows - rowsNow);
+			m.contracting = rowsNow < m.foldRows;
+			ok = m.rowsMoved > 0 && m.rowTop >= 0 && m.rowTop < H;
+			kexMotionStats.lines = static_cast<int>(m.rowsMoved);
+		} else {
+			ok = KexMotionSize(m.kind, &rows) && m.rowTop < H;
+			if (kind == KEXM_MOVELINE)
+				ok = ok && m.rowTop >= 0;	// the moved lines are on screen
+			else
+				ok = ok && m.rowTop + rows * lh > 0;	// some of the lines are
+			if (ok && kind == KEXM_MOVELINE) {
+				// now the moved lines start one line further on (or back) and the passed line is where they began (or ended)
+				const Sci::Line blockNow = m.lineFrom + m.lineDelta;
+				const Sci::Line passedNow = m.lineDelta > 0 ? m.lineFrom : m.lineTo - 1;
+				m.blockRows = pcs->DisplayFromDoc(blockNow + (m.lineTo - m.lineFrom)) - pcs->DisplayFromDoc(blockNow);
+				m.passedRows = pcs->GetHeight(passedNow);
+				ok = m.lineDelta != 0 && m.blockRows > 0 && m.passedRows > 0;
+				rows = static_cast<int>(m.blockRows);	// the moved lines' rows (a wrapped line takes several)
+			} else if (ok && kind == KEXM_INDENT) {
+				m.newX.clear();
+				for (Sci::Line line = m.lineFrom; line < m.lineTo; ++line)
+					m.newX.push_back(LocationFromPosition(pdoc->GetLineIndentPosition(line)).x);
+				ok = m.newX.size() == m.oldX.size() && m.newX != m.oldX;
+			} else if (ok && kind == KEXM_SORT) {
+				// each line now: which line it was (the same text, first not yet taken)
+				std::vector<bool> taken(m.oldText.size());
+				m.order.clear();
+				bool moved = false;
+				for (Sci::Line line = m.lineFrom; ok && line < m.lineTo; ++line) {
+					const std::string text = RangeText(pdoc->LineStart(line), pdoc->LineEnd(line));
+					int was = -1;
+					for (size_t j = 0; j < m.oldText.size(); ++j) {
+						if (!taken[j] && m.oldText[j] == text) {
+							was = static_cast<int>(j);
+							break;
+						}
+					}
+					ok = was >= 0;
+					if (ok) {
+						taken[was] = true;
+						moved = moved || was != static_cast<int>(line - m.lineFrom);
+						m.order.push_back(was);
+					}
+				}
+				ok = ok && moved;
+			}
+			kexMotionStats.lines = rows;
+		}
+		if (!ok) {
+			showNew();
+			++kexMotionStats.refused;
+			KexEndSlide(true, 9);
+			return;
+		}
+		m.started = true;
+		++kexMotionStats.started[kind];
+		kexMotionStats.lastKind = kind;
+		kexMotionStats.style = static_cast<int>(m.style);
+	}
+	++kexMotionStats.frames;
+	++kexSlideStats.frames;
+	if (KexIsEdit(kind))
+		KexPresentEdit(surfaceWindow, rcClient, t);
+	else if (kind == KEXM_JUMP)
+		KexPresentJump(surfaceWindow, rcClient, t);
+	else
+		KexPresentLines(surfaceWindow, rcClient, t);
+	if (t >= kexSlideMs)
+		KexEndSlide(false);
+}
+
+// Room a motion opened (text moved away from it): each row gets its line's own background, as Scintilla paints it
+// after the end of a line (the current line's colour, a marker's), not just the default one.
+void Editor::KexFillRows(Surface *surface, PRectangle rc) {
+	const XYPOSITION lh = vs.lineHeight;
+	if (lh <= 0 || rc.Width() <= 0 || rc.Height() <= 0)
+		return;
+	const Sci::Line caretLine = pdoc->SciLineFromPosition(sel.MainCaret());
+	const bool caretShows = !vs.caretLine.frame && (caret.active || vs.caretLine.alwaysShow);
+	for (XYPOSITION y = rc.top; y < rc.bottom;) {
+		const Sci::Line row = static_cast<Sci::Line>(std::floor(y / lh));
+		const XYPOSITION bottom = std::min(rc.bottom, static_cast<XYPOSITION>(row + 1) * lh);
+		const PRectangle part(rc.left, y, rc.right, bottom);
+		const Sci::Line line = pcs->DocFromDisplay(topLine + row);
+		const bool hasCaret = line == caretLine;
+		const ColourOptional back = vs.Background(pdoc->GetMark(line, false), caret.active, hasCaret);
+		surface->FillRectangle(part, back.value_or(vs.styles[StyleDefault].back));
+		if (!back && hasCaret && caretShows && vs.caretLine.layer != Layer::Base) {
+			if (const ColourOptional over = vs.ElementColour(Element::CaretLineBack))
+				surface->AlphaRectangle(part, 0, FillStroke(*over));
+		}
+		y = bottom;
+	}
+}
+
+// An edit at one place: the text after it glides from where it was to where it is now. Removed text goes in the
+// edit's style (lifted, wiped or faded, from the old picture); new text is uncovered in place, or (whole lines
+// duplicated) slides out from under the line above, and is lit for a moment.
+void Editor::KexPresentEdit(Surface *surfaceWindow, PRectangle rcClient, double t) {
+	const KexMotionState &m = kexMotion;
+	const XYPOSITION W = std::min<XYPOSITION>(rcClient.right, kexNewWidth), H = std::min<XYPOSITION>(rcClient.bottom, kexNewHeight);
+	surfaceWindow->Copy(PRectangle(rcClient.left, rcClient.top, W, H), Point(0, 0), *kexSlideNew);
+	const double ms = std::max(1, kexMotions.ms[static_cast<int>(m.kind)]);
+	const double f = std::clamp(t / ms, 0.0, 1.0);
+	const XYPOSITION lh = m.lineHeight, left = m.textLeft;
+	const XYPOSITION xs = std::round(std::max(m.at.x, left)), ys = std::round(m.at.y);
+	const XYPOSITION xo = std::round(std::max(m.oldEnd.x, left)), yo = std::round(m.oldEnd.y);
+	const XYPOSITION xn = std::round(std::max(m.newEnd.x, left)), yn = std::round(m.newEnd.y);
+	double closed = 1.0, opacity = 0.0, lift = 0.0, wiped = 0.0;
+	switch (m.style) {
+	case KexEditStyle::lift:
+		// picked up (rises 2 px, a soft shadow under it), then gone while the gap closes
+		lift = KexEaseOut(f / 0.3);
+		opacity = 1.0 - std::clamp((f - 0.25) / 0.35, 0.0, 1.0);
+		closed = KexSpring((f - 0.35) / 0.65);
+		break;
+	case KexEditStyle::wipe:
+		// wiped from its end back to the caret, then the rest of the line closes up
+		wiped = KexEaseOut(f / 0.4);
+		closed = KexSpring((f - 0.38) / 0.62);
+		break;
+	case KexEditStyle::fade: {
+		// fades out within the first 45 % (fast at first) while the text after it glides in from 12 %
+		const double fu = std::clamp(f / 0.45, 0.0, 1.0);
+		opacity = (1.0 - fu) * (1.0 - fu);
+		closed = KexSpring((f - 0.12) / 0.88);
+		break;
+	}
+	default:
+		closed = KexSpring(f);
+		break;
+	}
+	kexMotionStats.gap = static_cast<float>(1.0 - closed);
+	const XYPOSITION dx = std::round((1.0 - closed) * (xo - xn));
+	const XYPOSITION dy = std::round((1.0 - closed) * (yo - yn));
+	const XYPOSITION clipTop = m.style == KexEditStyle::peel ? m.peelTop : 0;
+	auto clip = [&](PRectangle rc) noexcept {
+		rc.left = std::max(rc.left, left);
+		rc.right = std::min(rc.right, W);
+		rc.top = std::max<XYPOSITION>(rc.top, clipTop);
+		rc.bottom = std::min(rc.bottom, H);
+		return rc;
+	};
+	auto shows = [](const PRectangle &rc) noexcept { return rc.Width() > 0 && rc.Height() > 0; };
+	// the rectangles text from (x0, y0) to (x1, y1) covers: the rest of its first line, whole lines, the start of its last
+	auto spans = [&](XYPOSITION x0, XYPOSITION y0, XYPOSITION x1, XYPOSITION y1, PRectangle *out) noexcept {
+		int n = 0;
+		if (y1 <= y0) {
+			out[n++] = PRectangle(x0, y0, x1, y0 + lh);
+		} else {
+			out[n++] = PRectangle(x0, y0, W, y0 + lh);
+			if (y1 > y0 + lh)
+				out[n++] = PRectangle(left, y0 + lh, W, y1);
+			out[n++] = PRectangle(left, y1, x1, y1 + lh);
+		}
+		return n;
+	};
+	auto put = [&](PRectangle src, XYPOSITION ox, XYPOSITION oy) {
+		const PRectangle dst = clip(PRectangle(src.left + ox, src.top + oy, src.right + ox, src.bottom + oy));
+		if (shows(dst))
+			surfaceWindow->Copy(dst, Point(dst.left - ox, dst.top - oy), *kexSlideNew);
+	};
+	// new text pushed the lines below down: the strip at the bottom shows lines the new picture has below the view,
+	// which the old picture still has
+	auto putBottom = [&]() {
+		if (dy >= 0)
+			return;
+		const XYPOSITION oy = std::round(closed * (yn - yo));
+		const XYPOSITION from = std::max<XYPOSITION>(H + dy, yo + lh + oy);
+		const PRectangle dst = clip(PRectangle(left, from, std::min<XYPOSITION>(W, kexOldWidth), std::min<XYPOSITION>(H, kexOldHeight + oy)));
+		if (shows(dst))
+			surfaceWindow->Copy(dst, Point(dst.left, dst.top - oy), *kexSlideOld);
+	};
+	IKexSurface *kex = dynamic_cast<IKexSurface *>(surfaceWindow);
+	const ColourRGBA back = vs.styles[StyleDefault].back;
+	const ColourRGBA light(kexMotions.light);
+	const int lightAlpha = static_cast<int>(light.GetAlpha() * KexLight(t, kexMotions.glowMs) + 0.5);
+	auto lightUp = [&](PRectangle rc) {
+		rc = clip(rc);
+		if (lightAlpha > 0 && shows(rc))
+			surfaceWindow->AlphaRectangle(rc, 0, FillStroke(ColourRGBA(light.GetRed(), light.GetGreen(), light.GetBlue(), lightAlpha)));
+	};
+	PRectangle added[3];
+	const int nAdded = m.inserted > 0 ? spans(xs, ys, xn, yn, added) : 0;
+	if (closed < 1.0) {
+		// where the text after the edit ends up, and the lines below, start empty
+		const PRectangle tailPlace = clip(PRectangle(xs, ys, W, ys + lh)), belowPlace = clip(PRectangle(left, ys + lh, W, H));
+		if (shows(tailPlace))
+			KexFillRows(surfaceWindow, tailPlace);
+		if (shows(belowPlace))
+			KexFillRows(surfaceWindow, belowPlace);
+		if (m.deleted > 0 && m.inserted == 0) {
+			// the removed text where it was, from the old picture
+			PRectangle gone[3];
+			const int nGone = spans(xs, ys, xo, yo, gone);
+			for (int i = 0; i < nGone; ++i) {
+				PRectangle rc = clip(gone[i]);
+				rc.right = std::min<XYPOSITION>(rc.right, kexOldWidth);
+				rc.bottom = std::min<XYPOSITION>(rc.bottom, kexOldHeight);
+				if (!shows(rc))
+					continue;
+				if (m.style == KexEditStyle::wipe) {
+					PRectangle rest = rc;
+					rest.right = std::round(rc.left + (rc.right - rc.left) * (1.0 - wiped));
+					if (shows(rest))
+						surfaceWindow->Copy(rest, Point(rest.left, rest.top), *kexSlideOld);
+					if (wiped < 1.0)
+						surfaceWindow->FillRectangle(PRectangle(rest.right - 1, rest.top + 2, rest.right + 1, rest.bottom - 2),
+							ColourRGBA(light.GetRed(), light.GetGreen(), light.GetBlue()));
+				} else if (m.style == KexEditStyle::lift) {
+					if (opacity <= 0.004)
+						continue;
+					const XYPOSITION up = std::round(2.0 * lift);
+					// a soft shadow: three widening layers under the raised piece
+					for (int k = 1; k <= 3; ++k) {
+						const PRectangle sh(rc.left - (k - 1), rc.top - up + k, rc.right + (k - 1), rc.bottom - up + k);
+						surfaceWindow->AlphaRectangle(sh, k, FillStroke(ColourRGBA(0, 0, 0, static_cast<int>(20 * lift * opacity))));
+					}
+					const PRectangle raised(rc.left, rc.top - up, rc.right, rc.bottom - up);
+					if (kex) {
+						surfaceWindow->AlphaRectangle(raised, 0, FillStroke(ColourRGBA(back.GetRed(), back.GetGreen(), back.GetBlue(), static_cast<int>(255 * opacity))));
+						kex->KexDrawPicture(raised, *kexSlideOld, rc, static_cast<float>(opacity));
+					} else if (opacity > 0.5) {
+						surfaceWindow->Copy(raised, Point(rc.left, rc.top), *kexSlideOld);
+					}
+				} else if (opacity > 0.004) {
+					if (kex)
+						kex->KexDrawPicture(rc, *kexSlideOld, rc, static_cast<float>(opacity));
+					else if (opacity > 0.5)
+						surfaceWindow->Copy(rc, Point(rc.left, rc.top), *kexSlideOld);
+				}
+			}
+		}
+		if (m.style == KexEditStyle::peel) {
+			// the copy and the lines below come down together from under the line
+			put(PRectangle(left, m.peelTop, W, H), 0, dy);
+			putBottom();
+			for (int i = 0; i < nAdded; ++i)
+				lightUp(PRectangle(added[i].left, added[i].top + dy, added[i].right, added[i].bottom + dy));
+			return;
+		}
+		// the new text in its place, uncovered as the text after it moves on
+		for (int i = 0; i < nAdded; ++i)
+			put(added[i], 0, 0);
+	}
+	for (int i = 0; i < nAdded; ++i)
+		lightUp(added[i]);
+	if (closed < 1.0) {
+		// the text after the edit, from the new picture, drawn back towards where it was
+		put(PRectangle(xn, yn, W, yn + lh), dx, dy);
+		put(PRectangle(left, yn + lh, W, H), 0, dy);
+		putBottom();
+	}
+}
+
+// Whole lines moving: a moved line and the one it passes, lines to a new indentation, a fold opening or closing,
+// sorted lines to their new places.
+void Editor::KexPresentLines(Surface *surfaceWindow, PRectangle rcClient, double t) {
+	const KexMotionState &m = kexMotion;
+	const XYPOSITION W = std::min<XYPOSITION>(rcClient.right, kexNewWidth), H = std::min<XYPOSITION>(rcClient.bottom, kexNewHeight);
+	const int kind = static_cast<int>(m.kind);
+	const double ms = std::max(1, kexMotions.ms[kind]);
+	const double p = KexSpring(t / ms);
+	kexMotionStats.gap = static_cast<float>(1.0 - p);
+	const XYPOSITION lh = m.lineHeight;
+	const XYPOSITION left = kind == KEXM_FOLD ? 0 : m.textLeft;	// a fold moves the line numbers too
+	auto shows = [](const PRectangle &rc) noexcept { return rc.Width() > 0 && rc.Height() > 0; };
+	auto copy = [&](Surface &pic, PRectangle src, XYPOSITION ox, XYPOSITION oy, XYPOSITION top) {
+		PRectangle dst(src.left + ox, src.top + oy, src.right + ox, src.bottom + oy);
+		dst.left = std::max(dst.left, left);
+		dst.right = std::min(dst.right, W);
+		dst.top = std::max(dst.top, top);
+		dst.bottom = std::min(dst.bottom, H);
+		if (shows(dst))
+			surfaceWindow->Copy(dst, Point(dst.left - ox, dst.top - oy), pic);
+	};
+	auto empty = [&](XYPOSITION top, XYPOSITION bottom) {
+		const PRectangle rc(left, std::max<XYPOSITION>(top, 0), W, std::min(bottom, H));
+		if (shows(rc))
+			KexFillRows(surfaceWindow, rc);
+	};
+	surfaceWindow->Copy(PRectangle(rcClient.left, rcClient.top, W, H), Point(0, 0), *kexSlideNew);
+	const XYPOSITION top = std::round(m.rowTop);
+	const XYPOSITION n = static_cast<XYPOSITION>(m.lineTo - m.lineFrom);
+	if (kind == KEXM_MOVELINE) {
+		// the moved lines (b high) and the line they pass (pr high) swap places: each band glides from where it was
+		const XYPOSITION b = static_cast<XYPOSITION>(m.blockRows) * lh, pr = static_cast<XYPOSITION>(m.passedRows) * lh;
+		const XYPOSITION blockMove = m.lineDelta > 0 ? pr : -pr;	// now less before
+		const XYPOSITION passedMove = m.lineDelta > 0 ? -b : b;
+		const XYPOSITION blockNow = top + blockMove;
+		const XYPOSITION passedNow = m.lineDelta > 0 ? top : top + b - pr;
+		empty(std::min(top, blockNow), std::max(top, blockNow) + b);
+		// the line passed, then the moved lines over it
+		copy(*kexSlideNew, PRectangle(left, passedNow, W, passedNow + pr), 0, std::round(-passedMove * (1.0 - p)), 0);
+		copy(*kexSlideNew, PRectangle(left, blockNow, W, blockNow + b), 0, std::round(-blockMove * (1.0 - p)), 0);
+	} else if (kind == KEXM_INDENT) {
+		for (size_t i = 0; i < m.newX.size(); ++i) {
+			const XYPOSITION y = top + static_cast<XYPOSITION>(i) * lh;
+			if (y >= H || y + lh <= 0)
+				continue;
+			empty(y, y + lh);
+			copy(*kexSlideNew, PRectangle(left, y, W, y + lh), std::round(-(m.newX[i] - m.oldX[i]) * (1.0 - p)), 0, 0);
+		}
+	} else if (kind == KEXM_FOLD) {
+		const XYPOSITION travel = static_cast<XYPOSITION>(m.rowsMoved) * lh;
+		if (m.contracting) {
+			// the old lines stay; the lines below come up over the hidden ones
+			copy(*kexSlideOld, PRectangle(left, top, W, H), 0, 0, top);
+			copy(*kexSlideNew, PRectangle(left, top, W, H), 0, std::round(travel * (1.0 - p)), top);
+		} else {
+			// the lines that were below go down, showing the lines that come back
+			copy(*kexSlideOld, PRectangle(left, top, W, H), 0, std::round(travel * p), top);
+		}
+	} else if (kind == KEXM_SORT) {
+		empty(top, top + n * lh);
+		// lines that stay first, then the ones on their way
+		for (int pass = 0; pass < 2; ++pass) {
+			for (size_t i = 0; i < m.order.size(); ++i) {
+				const int was = m.order[i];
+				if ((was != static_cast<int>(i)) != (pass == 1))
+					continue;
+				const XYPOSITION y = top + static_cast<XYPOSITION>(i) * lh;
+				copy(*kexSlideNew, PRectangle(left, y, W, y + lh), 0, std::round((was - static_cast<int>(i)) * lh * (1.0 - p)), 0);
+			}
+		}
+	}
+}
+
+// A long jump: the old view slides out and the new one follows, then a band shows the caret's line for a moment.
+void Editor::KexPresentJump(Surface *surfaceWindow, PRectangle rcClient, double t) {
+	const KexMotionState &m = kexMotion;
+	const XYPOSITION W = std::min<XYPOSITION>(rcClient.right, kexNewWidth), H = std::min<XYPOSITION>(rcClient.bottom, kexNewHeight);
+	const double ms = std::max(1, kexMotions.ms[KEXM_JUMP]);
+	const double e = KexSpring(t / ms);
+	kexMotionStats.gap = static_cast<float>(1.0 - e);
+	const int dir = m.jumpTo > m.jumpFrom ? 1 : -1;
+	const XYPOSITION shift = std::round(e * H);
+	const XYPOSITION yOld = -dir * shift, yNew = yOld + dir * H;
+	auto put = [&](Surface &pic, XYPOSITION y) {
+		const PRectangle rc(rcClient.left, std::max<XYPOSITION>(0, y), W, std::min(H, y + H));
+		if (rc.Width() > 0 && rc.Height() > 0)
+			surfaceWindow->Copy(rc, Point(rc.left, rc.top - y), pic);
+	};
+	put(*kexSlideNew, yNew);
+	if (e < 1.0)
+		put(*kexSlideOld, yOld);
+	// the band on the caret's line, once there
+	const ColourRGBA light(kexMotions.light);
+	const double band = KexLight(t - ms * 0.6, ms * 1.9);
+	const int a = static_cast<int>(light.GetAlpha() * 0.7 * band + 0.5);
+	if (a > 0 && e > 0.6) {
+		const Point caretAt = LocationFromPosition(sel.MainCaret());
+		const PRectangle rc(m.textLeft, std::round(caretAt.y) + yNew, W, std::round(caretAt.y) + yNew + m.lineHeight);
+		if (rc.top < H && rc.bottom > 0)
+			surfaceWindow->AlphaRectangle(rc, 0, FillStroke(ColourRGBA(light.GetRed(), light.GetGreen(), light.GetBlue(), a)));
+	}
+}
+
+// After a message that may scroll far (go to line, a found text shown, a bookmark): more than a screen moved
+// by the program, not by the user, slides the view there.
+void Editor::KexJumpCheck(Sci::Line topBefore) {
+	const Sci::Line moved = topLine - topBefore;
+	if (std::abs(moved) <= std::max<Sci::Line>(2, LinesOnScreen()) || !KexMotionOn(KexMotionKind::jump))
+		return;
+	if (KexNowMs() - kexDocSwitch < 500)
+		return;	// a document just put in shows where it was left, without a slide
+	if (kexSlideDir == 4 && kexMotion.kind == KexMotionKind::jump && !kexMotion.started)
+		return;	// already set up by an earlier message of the same jump
+	// the screen still shows the old lines: picture them there
+	const Sci::Line now = topLine;
+	SetTopLine(topBefore);
+	const bool on = KexMotionBegin(KexMotionKind::jump);
+	SetTopLine(now);
+	if (!on)
+		return;
+	kexMotion.open = false;
+	kexMotion.jumpFrom = topBefore;
+	kexMotionStats.jumpLines = static_cast<int>(moved);
+	Redraw();
+}
+
+// A search found text (SCI_SEARCHINTARGET), then the selection was set to it: a ring closes onto it.
+void Editor::KexRingCheck(Message iMessage) {
+	if (iMessage != Message::SetAnchor && iMessage != Message::SetSel && iMessage != Message::SetSelection)
+		return;
+	const double now = KexNowMs();
+	if (!KexMotionOn(KexMotionKind::find) || now - kexFoundAt > 250 || sel.Count() != 1)
+		return;
+	const SelectionRange range = sel.RangeMain();
