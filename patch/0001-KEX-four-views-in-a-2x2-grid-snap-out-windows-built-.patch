+// A fold the user asked for (margin click, toggle fold): the lines under it slide
+void Editor::KexFoldLine(Sci::Line line, FoldAction action) {
+	KexMotionKind kind = KexMotionKind::none;
+	Sci::Line header = line;
+	if (line >= 0 && line < pdoc->LinesTotal() && KexMotionOn(KexMotionKind::fold)) {
+		if (action == FoldAction::Toggle && !LevelIsHeader(pdoc->GetFoldLevel(header)))
+			header = pdoc->GetFoldParent(header);
+		if (header >= 0 && pcs->GetVisible(header) && pdoc->GetLastChild(header) > header)
+			kind = KexMotionKind::fold;
+	}
+	KexMotionScope scope(*this, kind);
+	if (scope.On()) {
+		kexMotion.lineFrom = header;
+		kexMotion.lineTo = pdoc->GetLastChild(header) + 1;
+		kexMotion.foldRows = pcs->DisplayFromDoc(kexMotion.lineTo) - pcs->DisplayFromDoc(header + 1);
+		kexMotion.rowTop = static_cast<XYPOSITION>(pcs->DisplayFromDoc(header + 1) - topLine) * vs.lineHeight;
+	}
+	FoldLine(line, action);
+}
