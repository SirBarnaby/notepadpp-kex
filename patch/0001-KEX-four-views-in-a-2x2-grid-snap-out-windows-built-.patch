+std::string Editor::CaseMapString(const std::string &s, CaseMapping caseMapping) {
+	std::string ret(s);
+	for (char &ch : ret) {
+		switch (caseMapping) {
+			case CaseMapping::upper:
+				ch = MakeUpperCase(ch);
+				break;
+			case CaseMapping::lower:
+				ch = MakeLowerCase(ch);
+				break;
+			default:	// no action
+				break;
+		}
+	}
+	return ret;
+}
