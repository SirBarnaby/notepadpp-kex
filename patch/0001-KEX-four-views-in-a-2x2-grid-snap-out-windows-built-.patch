+void ScintillaWin::DropRenderTarget() noexcept {
+#if defined(USE_D2D)
+	if (technology != Technology::Default)
+		KexDropPixmaps();	// KEX: pictures made from the target go with it (GDI's don't need one: a resize keeps them)
+	targets.Release();
+#endif
