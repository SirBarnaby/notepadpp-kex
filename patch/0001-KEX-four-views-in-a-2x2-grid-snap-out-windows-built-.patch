-	}
-
-	if (hasUnicodeText) {
-		UndoGroup ug(pdoc);
-		const PasteShape pasteShape = isRectangular ? PasteShape::rectangular : (isLine ? PasteShape::line : PasteShape::stream);
-		ClearSelection(multiPasteMode == MultiPaste::Each);
