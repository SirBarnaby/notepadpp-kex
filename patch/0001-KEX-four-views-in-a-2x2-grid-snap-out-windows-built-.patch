+void Editor::RefreshStyleData() {
+	if (!stylesValid) {
+		stylesValid = true;
+		AutoSurface surface(this);
+		if (surface) {
+			vs.Refresh(*surface, pdoc->tabInChars);
+		}
+		SetScrollBars();
+		SetRectangularRange();
+	}
