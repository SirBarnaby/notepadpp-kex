+// KEX: the commands of the built-in KEX features, registered like a plugin's commands (module "KEX")
+// so Shortcut Mapper lists them and keeps their keys in shortcuts.xml, but in a menu of the feature's.
+void PluginsManager::kexAddCommands(HMENU menu, const KexCommandList& list)
+{
+	vector<PluginCmdShortcut>& pluginCmdSCList = (NppParameters::getInstance()).getPluginCommandList();
+	for (int j = 0; j < list.count; ++j)
+	{
+		const KexCommand& c = list.items[j];
+		_pluginsCommands.push_back(PluginCommand(L"KEX", c.internalId, c.run));
+		_pluginsCommands.back()._kexAware = true;
+		const int cmdID = ID_PLUGINS_CMD + static_cast<int>(_pluginsCommands.size() - 1);
+		if (list.ids)
+			list.ids[j] = cmdID;
+		const string itemName = wstring2string(c.name, CP_UTF8);
+		PluginCmdShortcut pcs(Shortcut(itemName.c_str(), c.ctrl, c.alt, c.shift, c.key), cmdID, "KEX", c.internalId);
+		pluginCmdSCList.push_back(pcs);
+		::InsertMenu(menu, list.position < 0 ? static_cast<UINT>(-1) : static_cast<UINT>(list.position + j), MF_BYPOSITION | MF_STRING, cmdID, c.name);
+	}
+}
