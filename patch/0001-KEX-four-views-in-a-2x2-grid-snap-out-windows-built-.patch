-HRESULT ScintillaWin::CreateSwapChain(HWND hwnd) {
-	// Sets pDXGISwapChain but only when each call succeeds
-	// Needs pDXGIDevice, pDirect3DDevice
-	pDXGISwapChain = nullptr;
