+		InvalidateSelection(rangeNew);
+	}
+	sel.Clear();
+	sel.RangeMain() = rangeNew;
+	SetRectangularRange();
+	ClaimSelection();
+	SetHoverIndicatorPosition(sel.MainCaret());
+
+	if (marginView.highlightDelimiter.NeedsDrawing(currentLine)) {
+		RedrawSelMargin();
+	}
+	QueueIdleWork(WorkItems::updateUI);
+}
