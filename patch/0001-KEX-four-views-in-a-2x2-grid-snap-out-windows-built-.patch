+	const int scale = GetFirstIntegralMultipleDeviceScaleFactor();
+	width = static_cast<UINT>(std::max(1L, (rc.right - rc.left) * scale));
+	height = static_cast<UINT>(std::max(1L, (rc.bottom - rc.top) * scale));
