+namespace {
+bool KexSameTarget(const KexCaretTarget &a, const KexCaretTarget &b) noexcept {
+	return std::abs(a.x - b.x) < 0.1 && std::abs(a.y - b.y) < 0.1 && std::abs(a.w - b.w) < 0.1 &&
+		std::abs(a.h - b.h) < 0.1 && a.block == b.block && a.colour == b.colour && a.blinks == b.blinks;
+}
