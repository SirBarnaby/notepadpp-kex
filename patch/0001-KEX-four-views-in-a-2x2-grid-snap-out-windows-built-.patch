+// The ring: from twice the size of the found text down onto it, on the spring, then gone; a light fill under it.
+void Editor::KexPaintRing(Surface *surfaceWindow, PRectangle rcArea) {
+	if (!KexRingLive()) {
+		kexRingStartMs = -1;
+		return;
+	}
+	const double ms = std::max(1, kexMotions.ms[KEXM_FIND]);
+	double t = KexNowMs() - kexRingStartMs;
+	if (kexSlideFreeze >= 0)
+		t = std::min(t, kexSlideFreeze * ms * 1.8);
+	if (t < 0)
+		return;	// waits for the jump to it to be done
+	const Point a = LocationFromPosition(kexRingStart), b = LocationFromPosition(kexRingEnd);
+	const XYPOSITION lh = vs.lineHeight;
+	const XYPOSITION right = b.y > a.y ? std::max(a.x + lh, static_cast<XYPOSITION>(GetClientRectangle().right) - 4) : b.x;
+	const XYPOSITION cx = (a.x + right) / 2, cy = a.y + lh / 2;
+	const double u = std::clamp(t / ms, 0.0, 1.0);
+	const XYPOSITION scale = 1.0 + 1.2 * (1.0 - KexSpring(u));
+	const XYPOSITION w = (right - a.x + 6) * scale, h = lh * scale;
+	const PRectangle ring(std::round(cx - w / 2), std::round(cy - h / 2), std::round(cx + w / 2), std::round(cy + h / 2));
+	const ColourRGBA light(kexMotions.light);
+	const double strokeA = 1.0 - std::clamp((t - ms * 0.6) / (ms * 1.2), 0.0, 1.0);
+	const double fillA = 0.45 * (1.0 - std::clamp(t / (ms * 1.8), 0.0, 1.0)) * KexSpring(u * 1.6);
+	surfaceWindow->SetClip(rcArea);
+	surfaceWindow->AlphaRectangle(ring, 3, FillStroke(
+		ColourRGBA(light.GetRed(), light.GetGreen(), light.GetBlue(), static_cast<int>(255 * fillA)),
+		ColourRGBA(light.GetRed(), light.GetGreen(), light.GetBlue(), static_cast<int>(255 * strokeA)), 2.0));
+	surfaceWindow->PopClip();
+	++kexMotionStats.ringFrames;
+}
