+void Editor::KexEndSlide(bool cancelled, int why) noexcept {
+	if (cancelled && (kexSlideOld || kexSlideCapture)) {
+		++kexSlideStats.cancelled;
+		kexSlideStats.stopReason = why;
+	}
+	if (kexSlideDir == 4) {
+		kexMotion.open = false;
+		std::vector<std::string>().swap(kexMotion.oldText);
+	}
+	kexSlideOld.reset();
+	kexSlideNew.reset();
+	kexSlideCapture = false;
+	kexSlideDir = 0;
+	kexSlideStart = -1;
+	kexSlideHeld = -1;
+}
