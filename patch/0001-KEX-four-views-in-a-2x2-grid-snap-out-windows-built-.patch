+// SCI_KEX_GLASSTEST: the view painted the way glass draws it, into a picture with alpha, and its pixels counted
+sptr_t ScintillaWin::KexGlassTestPaint(KexGlassTest *test) {
+	if (!test)
+		return 0;
+	test->clear = test->solid = test->partial = test->keyLeft = 0;
+	test->error = E_FAIL;
