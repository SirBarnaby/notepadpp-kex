+// KEX: "Notepad++ KEX v8.x" instead of "Notepad++ v8.x"
+static wstring kexBrandedVersion()
+{
+	wstring version = NOTEPAD_PLUS_VERSION;
+	const wstring name = L"Notepad++";
+	if (version.compare(0, name.size(), name) == 0)
+		version.insert(name.size(), L" KEX");
+	return version;
+}
+
+// KEX: the About box shows the branded version; the bitness label after it moves along
+static void kexBrandAboutVersion(HWND dlg)
+{
+	const wstring version = NOTEPAD_PLUS_VERSION;
+	const wstring branded = kexBrandedVersion();
+	for (HWND child = ::GetWindow(dlg, GW_CHILD); child; child = ::GetWindow(child, GW_HWNDNEXT))
+	{
+		wchar_t text[64]{};
+		::GetWindowText(child, text, 64);
+		if (version != text)
+			continue;
+		HDC hdc = ::GetDC(child);
+		HGDIOBJ oldFont = ::SelectObject(hdc, reinterpret_cast<HFONT>(::SendMessage(child, WM_GETFONT, 0, 0)));
+		SIZE before{}, after{};
+		::GetTextExtentPoint32(hdc, version.c_str(), static_cast<int>(version.size()), &before);
+		::GetTextExtentPoint32(hdc, branded.c_str(), static_cast<int>(branded.size()), &after);
+		::SelectObject(hdc, oldFont);
+		::ReleaseDC(child, hdc);
+		::SetWindowText(child, branded.c_str());
+		if (HWND bit = ::GetDlgItem(dlg, IDC_VERSION_BIT))
+		{
+			RECT rc{};
+			::GetWindowRect(bit, &rc);
+			::MapWindowPoints(nullptr, dlg, reinterpret_cast<POINT*>(&rc), 2);
+			::SetWindowPos(bit, nullptr, rc.left + after.cx - before.cx, rc.top, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+		}
+		break;
+	}
+}
