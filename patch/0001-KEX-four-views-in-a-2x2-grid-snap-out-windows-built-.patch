-		switch (static_cast<int>(inputStyle.at(i))) {
-		case ATTR_INPUT:
-			imeIndicator[i] = IndicatorInput;
-			break;
-		case ATTR_TARGET_NOTCONVERTED:
-		case ATTR_TARGET_CONVERTED:
-			imeIndicator[i] = IndicatorTarget;
-			break;
-		case ATTR_CONVERTED:
-			imeIndicator[i] = IndicatorConverted;
-			break;
