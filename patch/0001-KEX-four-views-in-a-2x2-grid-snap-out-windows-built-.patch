+	kexGlassKey = key & 0xFFFFFF;
+	kexGlassSharp = (flags & KEXGLASS_SHARP) != 0;
+	if (technology == Technology::Default) {	// glass needs Direct2D
+		KexGlassStop();
+		kexGlassState = 2;
+		kexGlassInfo.lastError = E_NOTIMPL;
+		return false;
+	}
+	if (!wasOn) {
+		// the window's own drawing target would cover the hole the host cuts out
+		DropRenderTarget();
+		pDXGISwapChain = nullptr;
+		kexGlassStreak = 0;
+		const HRESULT hr = KexGlassCreate();
