-SelectionRange Editor::SelectionMove(Scintilla::Message iMessage, size_t r) {
-	const SelectionPosition spCaretStart = sel.Range(r).caret;
-	const SelectionPosition spCaretMoved = PositionMove(iMessage, spCaretStart);
