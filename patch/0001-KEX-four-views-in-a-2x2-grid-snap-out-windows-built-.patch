+		hr = kexLayer.visual->SetContent(kexLayer.surface.Get());
+	if (SUCCEEDED(hr))
+		hr = kexLayer.target->SetRoot(kexLayer.visual.Get());
+	if (SUCCEEDED(hr))
+		hr = kexLayer.device->Commit();
+	if (FAILED(hr)) {
+		kexLayer.Release();
+		return hr;
+	}
+	kexLayer.width = width;
+	kexLayer.height = height;
