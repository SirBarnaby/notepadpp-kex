+Editor::KexJumpWatcher::KexJumpWatcher(Editor &ed_, Message message_) noexcept : ed(ed_), message(message_) {
+	switch (message) {
+	case Message::GotoLine:
+	case Message::GotoPos:
+	case Message::SetSel:
+	case Message::SetFirstVisibleLine:
+	case Message::EnsureVisibleEnforcePolicy:
+	case Message::ScrollCaret:
+	case Message::ScrollRange:
+		// not LineScroll: Notepad++ scrolls the other view with it to keep both in step
+		counted = true;
+		outer = ++ed.kexJumpWatch == 1;
+		top = ed.topLine;
+		break;
+	default:
+		break;
+	}
+}
+
+Editor::KexJumpWatcher::~KexJumpWatcher() {
+	if (counted)
+		--ed.kexJumpWatch;
+	try {
+		if (outer && ed.topLine != top)
+			ed.KexJumpCheck(top);
+		ed.KexRingCheck(message);
+	} catch (...) {
+		// no motion then
+	}
+}
