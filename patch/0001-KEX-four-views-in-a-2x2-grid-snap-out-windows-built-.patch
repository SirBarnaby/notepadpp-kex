+void ScintillaWin::Finalise() {
+	ScintillaBase::Finalise();
+	for (TickReason tr = TickReason::caret; tr <= TickReason::kexCaret;	// KEX: kexCaret
+		tr = static_cast<TickReason>(static_cast<int>(tr) + 1)) {
+		FineTickerCancel(tr);
+	}
+	SetIdle(false);
+	DropRenderTarget();
+	::RevokeDragDrop(MainHWND());
+	if (SUCCEEDED(hrOle)) {
+		::OleUninitialize();
+	}
+}
