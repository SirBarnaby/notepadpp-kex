new file mode 100644
index 0000000..b893693
--- /dev/null
+++ b/scintilla/include/KexScintilla.h
@@ -0,0 +1,148 @@
+// KexScintilla.h - Notepad++ KEX additions to Scintilla: the smooth caret, the tab slide, the motion of
+// edits, and glass.
+//
+// Scintilla draws the caret itself, as usual, but glides it to each new position with an ease-out
+// curve and fades it in and out instead of blinking hard. The caret is drawn after the text in the
+// same paint, so it moves in the same frame as the text, including while scrolling.
+#ifndef KEXSCINTILLA_H
+#define KEXSCINTILLA_H
+
+// wParam: glide time in milliseconds (0 = jump), lParam: KEXCARET_* flags. KEXCARET_ON off = Scintilla's
+// normal caret.
+#define SCI_KEX_SETSMOOTHCARET 0x4B43
+#define KEXCARET_ON 0x1
+#define KEXCARET_FADE 0x2              // fade in and out instead of blinking on and off
+#define KEXCARET_OVERTYPE_BLOCK 0x4    // a block caret in overtype mode
+#define KEXCARET_SNAPLINES(n) (((n) & 0xFF) << 8)   // jumps of more lines than this don't glide (0 = 12)
+#define KEXCARET_NOBLINK 0x8           // the caret never blinks
+#define KEXCARET_FADEMS(ms) (((ms) & 0xFFF) << 16)  // KEXCARET_FADE: each fade's length in ms (0 = 140)
+
+// lParam: KexCaretInfo*, filled with what the last paint drew (for Notepad++ KEX's self-test).
+#define SCI_KEX_GETCARETINFO 0x4B44
+struct KexCaretInfo {
+	int on;              // smooth caret on in this view
+	int visible;         // a caret was drawn at the last paint
+	int carets;          // carets drawn
+	float mainX, mainY, mainH;   // the main caret's rectangle (client coordinates), as drawn
+	int block;           // the main caret is a block
+	int frames;          // paints that drew carets
+	double workMs;       // time spent working out and drawing carets
+	float alpha;         // the main caret's blink opacity at the last paint (1 = fully on, 0 = off)
+	int fadeMs;          // each fade's length (KEXCARET_FADEMS)
+};
+
+// Self-test only: wParam = glide fraction to stop at in thousandths (-1 = run normally), lParam = 1 for
+// a solid caret (no blinking).
+#define SCI_KEX_CARETTEST 0x4B45
+
+// Tab slide. Sent just before another document is put into the view (SCI_SETDOCPOINTER): wParam = 1 when
+// the new document should come in from the right, -1 from the left; lParam: the slide's length in
+// milliseconds. The view paints what it shows now into a picture at once; from the next paint on, that
+// picture slides out while the new document slides in. LRESULT: 1 when the slide is set up, 0 when the
+// view can't (hidden, no size). wParam 0 stops a slide. lParam 0: the slide doesn't run on its own but stays
+// where SCI_KEX_SLIDEPOS puts it (a touchpad swipe moves it with the fingers), starting with the old picture.
+#define SCI_KEX_SLIDE 0x4B46
+// lParam: KexSlideInfo*. LRESULT: 1 while a slide is running or set up.
+#define SCI_KEX_GETSLIDEINFO 0x4B47
+struct KexSlideInfo {
+	int active;          // a slide is set up or running
+	int slides;          // slides started
+	int frames;          // slide frames painted
+	int captures;        // old pictures taken
+	int cancelled;       // slides stopped early (resize, a new render target)
+	float fraction;      // how far the last frame was, 0..1
+	int stopReason;      // why the last slide stopped early: 1 the view had no size, 2 or 3 no picture could be made,
+	                     // 4 stopped (SCI_KEX_SLIDE 0), 5 the drawing target was dropped, 6 nothing was painted
+	int held;            // the slide is set up to stay where SCI_KEX_SLIDEPOS puts it
+};
+// Self-test only: wParam = fraction in thousandths to stop the slide at (-1 = run normally). wParam -2: lParam 1 paints
+// the view's picture again for every frame of a motion, as before it was kept (to compare the speed), 0 keeps it.
+#define SCI_KEX_SLIDETEST 0x4B48
+// A slide started with lParam 0 (held): wParam = how far the new document is in, in ten-thousandths of the
+// view's width (0 = only the old picture, 10000 = only the new document). lParam 1 ends the slide there:
+// the view paints as usual again. LRESULT: 1 when there was a slide to move.
+#define SCI_KEX_SLIDEPOS 0x4B49
+
+// Motion (Notepad++ KEX): the view animates its own edits. Each one is set up as the edit starts: the view is
+// painted into a picture at once (what is on screen), the edit happens, and then every frame is put together from
+// that picture and the view as it is now, so text never blurs and nothing floats over other text. All of them
+// are short, move on a critically damped spring (no bounce) and stop at once on typing, any other change to the
+// text, a scroll or a new size, so they never hold up editing. Off unless set with SCI_KEX_SETMOTIONS.
+//   cut           the cut text is picked up (rises a little, with a soft shadow), then goes; the gap closes
+//   delete        Delete or Backspace on a selection within one line: wiped from its end back to the caret
+//   delete lines  ... over several lines: it fades where it was while the text after it glides up into place
+//   paste         the text after the caret moves to make room and the pasted text is uncovered, lit for a moment
+//   undo / redo   the same for text that comes back, a close-up for text that goes
+//   move line     the moved lines slide to their new place, the line they pass the other way
+//   find          a ring closes onto a match that a search selected (SCI_SEARCHINTARGET, then the selection)
+//   indent        Tab / Shift+Tab on several lines: they glide to the new indentation
+//   duplicate     a copy of the line slides out from under it; the lines below make room
+//   jump          a programmatic scroll of more than a screen (go to line, bookmarks, find): the view slides
+//                 there, and a band marks the caret's line for a moment
+//   fold          the lines under a folded line slide up over the hidden ones (down again to unfold)
+//   sort          SCI_REPLACETARGET that only reorders whole lines: each line glides to its new place
+// wParam: const KexMotions*. LRESULT: 1.
+#define SCI_KEX_SETMOTIONS 0x4B4E
+enum {
+	KEXM_CUT, KEXM_DELETE, KEXM_DELETELINES, KEXM_PASTE, KEXM_UNDO, KEXM_MOVELINE, KEXM_FIND, KEXM_INDENT,
+	KEXM_DUPLICATE, KEXM_JUMP, KEXM_FOLD, KEXM_SORT, KEXM_COUNT
+};
+struct KexMotions {
+	int ms[KEXM_COUNT];  // how long each takes, in ms; 0 = off
+	int glowMs;          // paste, undo and duplicate: how long the new text stays lit (0 = no light)
+	int rapidMs;         // a motion that would start within this long of the last one is skipped: fast editing
+	int light;           // 0xAABBGGRR: the light on new text, the find ring and the jump's band
+};
+// lParam: KexMotionInfo*. LRESULT: 1 while a motion is set up or running.
+#define SCI_KEX_GETMOTIONINFO 0x4B4F
+struct KexMotionInfo {
+	int started[KEXM_COUNT];  // motions played, by kind
+	int skipped;              // not played: it came too soon after the last one
+	int refused;              // not played: off screen, several changes at once, the lines wrap, ...
+	int ended;                // stopped early by typing, another change, a scroll or a new size
+	int frames;               // frames painted
+	int lastKind;             // KEXM_* of the last motion started, -1 for none
+	float fraction;           // how far the last frame was, 0..1
+	float gap;                // how far the moving text still was from its place in the last frame, 0..1
+	int style;                // the last edit motion: 1 lift, 2 wipe, 3 fade, 4 uncover, 5 peel
+	int ringFrames;           // frames painted with the find ring
+	int jumpLines;            // the last jump: lines between the old and the new first line (negative: up)
+	int lines;                // the last line motion: lines that moved (move line, indent, fold, sort)
+	float caretX;             // the last edit motion's frame: where the main caret showed (client x)
+	float renderMs;           // time spent on the motions' frames: painting the view's picture, and putting the frame together
+	float presentMs;
+	int renders;              // frames that painted the view's picture, and frames that used it as it was
+	int reuses;
+};
+
+// Glass (Notepad++ KEX's see-through editor). wParam: KEXGLASS_* flags (0 = off); lParam: the colour (0xBBGGRR) that is to
+// show as nothing. The view then draws into a DirectComposition layer on top of its window, where that colour is
+// see-through and text is smoothed in grey (ClearType needs a solid background), while the window itself is filled
+// with that colour for a colour-keyed host window to cut out. Needs a DirectWrite technology. LRESULT: 1 when glass is
+// on, 0 when this system can't (no DirectComposition, as under Wine): the view then draws as usual.
+#define SCI_KEX_GLASS 0x4B4A
+#define KEXGLASS_ON 0x1
+#define KEXGLASS_SHARP 0x2         // text edges without smoothing
+// lParam: KexGlassInfo* (may be 0). LRESULT: 0 off, 1 on, 2 asked for but failed (the view draws as usual).
+#define SCI_KEX_GETGLASS 0x4B4B
+struct KexGlassInfo {
+	int state;           // as the LRESULT
+	int frames;          // paints drawn into the layer
+	int failures;        // drawing attempts that failed (the layer is rebuilt; after a few the view gives up)
+	int lastError;       // the last failure's HRESULT
+	int width, height;   // the layer's size in pixels
+};
+// Self-test only: lParam: KexGlassTest*. Paints the view off screen the way glass draws it (Direct2D on a DIB with
+// alpha, so it runs without DirectComposition) and counts the pixels. LRESULT: 1 when it could paint.
+#define SCI_KEX_GLASSTEST 0x4B4C
+struct KexGlassTest {
+	int key;             // in: the see-through colour (0xBBGGRR)
+	int sharp;           // in: text without smoothing
+	int error;           // out: HRESULT of the off-screen drawing
+	int clear;           // out: fully see-through pixels
+	int solid;           // out: fully opaque pixels
+	int partial;         // out: partly see-through pixels (smoothed text edges, translucent fills)
+	int keyLeft;         // out: opaque pixels still in the see-through colour (should be 0)
+};
+
+#endif
