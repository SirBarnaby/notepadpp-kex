+			kexGlassState = 2;
+			kexGlassInfo.lastError = hr;
+			Redraw();
+			return false;
+		}
+	}
+	kexGlassState = 1;
+	// pictures were made without see-through pixels (or with another key)
+	DropGraphics();
+	KexDropPixmaps();
+	Redraw();
+	return true;
