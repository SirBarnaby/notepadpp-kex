+// KEX: notifications from views 3 and 4 only go to plugins that export kexAware(). Older plugins
+// only know the two Scintilla handles in NppData and would act on the wrong view.
+void PluginsManager::notifyKexAware(const SCNotification *notification)
+{
+	if (_noMoreNotification)
+		return;
+
+	SCNotification kexNotif = *notification;
+	kexsuite::notify(&kexNotif);
+
+	for (size_t i = 0, len = _pluginInfos.size() ; i < len ; ++i)
+	{
+		if (_pluginInfos[i]->_kexAware)
+			notify(i, notification);
+	}
+}
