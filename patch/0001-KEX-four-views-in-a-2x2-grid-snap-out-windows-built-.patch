+		pluginCmdSCList.push_back(pcs);
+		::InsertMenu(menu, list.position < 0 ? static_cast<UINT>(-1) : static_cast<UINT>(list.position + j), MF_BYPOSITION | MF_STRING, cmdID, c.name);
+	}
+}
