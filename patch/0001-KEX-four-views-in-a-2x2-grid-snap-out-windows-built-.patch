+			}
+		}
+		::SelectObject(hdcMem, old);
+	}
+	if (dib)
+		::DeleteObject(dib);
+	if (hdcMem)
+		::DeleteDC(hdcMem);
+	test->error = hr;
+	Redraw();
+	return SUCCEEDED(hr) ? 1 : 0;
+}
