// KexSuite.rc - the KEX Settings window (KEX > Settings...) and its pages: the same size, layout and style
// as Notepad++'s Preferences dialog and pages
#include <windows.h>
#include <commctrl.h>
#include "KexSuiteRes.h"

IDD_KEX_SETTINGS DIALOGEX 0, 0, 580, 235
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_WINDOWEDGE
CAPTION "KEX Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LISTBOX         IDC_KEX_PAGELIST, 10, 10, 100, 215, LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "All animations, speed (%):", -1, 115, 218, 92, 8
    EDITTEXT        IDC_KEX_SPEED, 208, 216, 28, 12, ES_NUMBER
    PUSHBUTTON      "Close", IDC_KEX_CLOSE, 320, 215, 50, 14
END

IDD_KEX_PAGE_EDITING DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Falling letters (CS2D style)", -1, 4, 2, 452, 66
    AUTOCHECKBOX    "Deleted text falls off the screen", IDC_L_EN, 12, 15, 160, 10
    LTEXT           "", IDC_L_STATUS, 180, 16, 268, 9
    LTEXT           "Gravity (px/s²):", -1, 12, 33, 56, 8
    EDITTEXT        IDC_L_GRAVITY, 70, 31, 34, 12, ES_NUMBER
    LTEXT           "Max letters:", -1, 116, 33, 42, 8
    EDITTEXT        IDC_L_MAX, 160, 31, 30, 12, ES_NUMBER
    LTEXT           "Spin (°/s):", -1, 202, 33, 38, 8
    EDITTEXT        IDC_L_SPIN, 242, 31, 30, 12, ES_NUMBER
    LTEXT           "Drift (px/s):", -1, 284, 33, 44, 8
    EDITTEXT        IDC_L_DRIFT, 330, 31, 30, 12, ES_NUMBER
    LTEXT           "Opacity (%):", -1, 372, 33, 44, 8
    EDITTEXT        IDC_L_OPACITY, 418, 31, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Not when Windows animation effects are off", IDC_L_RESPECT, 12, 50, 170, 10
    AUTOCHECKBOX    "Also on undo and redo", IDC_L_UNDO, 190, 50, 100, 10

    GROUPBOX        "Smooth caret", -1, 4, 74, 452, 50
    AUTOCHECKBOX    "The caret glides to its new position", IDC_C_EN, 12, 87, 160, 10
    LTEXT           "", IDC_C_STATUS, 180, 88, 268, 9
    LTEXT           "Glide speed (%):", -1, 12, 105, 58, 8
    EDITTEXT        IDC_C_GLIDE, 72, 103, 26, 12, ES_NUMBER
    LTEXT           "Jump instead after (lines):", -1, 106, 105, 92, 8
    EDITTEXT        IDC_C_SNAP, 200, 103, 24, 12, ES_NUMBER
    LTEXT           "Blink:", -1, 234, 105, 22, 8
    COMBOBOX        IDC_C_BLINK, 258, 103, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Block caret in overtype", IDC_C_OVB, 366, 104, 86, 10

    GROUPBOX        "JetBrains shortcuts", -1, 4, 130, 452, 58
    AUTOCHECKBOX    "IntelliJ editor keys: Alt+J next occurrence, Ctrl+W extend selection, Ctrl+/ comment...", IDC_J_EN, 12, 141, 300, 10
    LTEXT           "", IDC_J_STATUS, 318, 142, 130, 9
    AUTOCHECKBOX    "Also the keys Notepad++ uses for something else (Ctrl+Y, Ctrl+W, Ctrl+R, F11, Ctrl+Num +/-...)", IDC_J_ALL, 12, 154, 340, 10
    LTEXT           "Alt+J case:", -1, 12, 171, 40, 8
    COMBOBOX        IDC_J_CASE, 54, 169, 104, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Whole words:", -1, 168, 171, 46, 8
    COMBOBOX        IDC_J_WORDS, 216, 169, 148, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Change keys...", IDC_J_LIST, 376, 168, 70, 13

    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END

IDD_KEX_PAGE_TABS DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Tab snapping", -1, 4, 2, 452, 64
    AUTOCHECKBOX    "Drag a tab to the edge of a view to open it beside that view", IDC_S_EN, 12, 15, 214, 10
    LTEXT           "", IDC_S_STATUS, 232, 16, 216, 9
    AUTOCHECKBOX    "Animate the preview", IDC_S_ANIM, 12, 31, 100, 10
    AUTOCHECKBOX    "Lift the tab off the bar while it is dragged", IDC_S_LIFT, 120, 31, 200, 10
    LTEXT           "A preview shows where the tab will land. Drop it on another view to move it there; hold Ctrl to clone it instead. Esc cancels. Off: dropping a tab on its own view shows the Move/Clone menu.", -1, 12, 45, 436, 18

    GROUPBOX        "F12 hover tabs", -1, 4, 72, 452, 46
    AUTOCHECKBOX    "In F12 mode, the top edge of a view shows its tabs", IDC_T_EN, 12, 85, 204, 10
    LTEXT           "", IDC_T_STATUS, 222, 86, 226, 9
    LTEXT           "Hot zone (px):", -1, 12, 103, 50, 8
    EDITTEXT        IDC_T_ZONE, 64, 101, 26, 12, ES_NUMBER
    LTEXT           "Hide after (ms):", -1, 102, 103, 56, 8
    EDITTEXT        IDC_T_DELAY, 160, 101, 30, 12, ES_NUMBER

    GROUPBOX        "Touchpad tab swipe", -1, 4, 122, 452, 66
    AUTOCHECKBOX    "Two fingers swiped sideways on the touchpad switch to the tab beside", IDC_SW_EN, 12, 135, 254, 10
    LTEXT           "", IDC_SW_STATUS, 272, 136, 176, 9
    LTEXT           "Sensitivity (%):", -1, 12, 151, 54, 8
    EDITTEXT        IDC_SW_SENS, 68, 149, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Swipe left goes to the tab on the right", IDC_SW_REVERSE, 110, 150, 170, 10
    LTEXT           "The tab follows your fingers. Let go past half way, or flick, to switch; let go before that and it slides back. Where a long line scrolls sideways the swipe scrolls it first; over the tab bar it always switches tabs.", -1, 12, 164, 436, 18

    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END

IDD_KEX_PAGE_WINDOWS DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "A Notepad++ for each desktop", -1, 4, 4, 452, 66
    AUTOCHECKBOX    "Starting Notepad++ on a desktop without one opens a new window there", IDC_D_EN, 12, 17, 262, 10
    LTEXT           "", IDC_D_STATUS, 280, 18, 168, 9
    LTEXT           "The new window opens with the same tabs, active tabs and carets as the first one, and with a copy of every untitled tab. Windows never move to another desktop.", -1, 12, 32, 436, 17
    LTEXT           "", IDC_D_INFO, 12, 54, 436, 9

    GROUPBOX        "Glass text area", -1, 4, 76, 452, 104
    AUTOCHECKBOX    "Windows' blur shows through the background of the text", IDC_G_EN, 12, 89, 214, 10
    LTEXT           "", IDC_G_STATUS, 232, 90, 216, 9
    LTEXT           "Style:", -1, 12, 107, 40, 8
    COMBOBOX        IDC_G_STYLE, 58, 105, 92, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tint (%):", -1, 164, 107, 32, 8
    EDITTEXT        IDC_G_TINT, 198, 105, 26, 12, ES_NUMBER
    AUTOCHECKBOX    "Plain blur while the window moves (no acrylic lag)", IDC_G_SMOOTHMOVE, 238, 106, 210, 10
    LTEXT           "Text edges:", -1, 12, 125, 44, 8
    COMBOBOX        IDC_G_EDGES, 58, 123, 166, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Margins too (line numbers, bookmarks, folding)", IDC_G_MARGINS, 238, 124, 200, 10
    LTEXT           "", IDC_G_INFO, 12, 144, 436, 30

    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END

IDD_KEX_PAGE_HIGHLIGHT DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Live token styles", -1, 4, 2, 452, 104
    AUTOCHECKBOX    "Style All Occurrences of Token also styles the ones you type later, and can make them bold or italic", IDC_K_EN, 12, 15, 352, 10
    LTEXT           "", IDC_K_STATUS, 370, 16, 78, 9
    LTEXT           "Menu key:", -1, 12, 33, 36, 8
    LTEXT           "", IDC_K_KEY, 50, 33, 84, 9
    PUSHBUTTON      "Change keys...", IDC_K_KEYMAP, 140, 31, 70, 13
    AUTOCHECKBOX    "Remember the styled tokens of each file", IDC_K_REMEMBER, 296, 32, 152, 10
    LTEXT           "Right-click a word > Style All Occurrences of Token, or press the menu key, to give it one of the five styles, bold or italic. Text you type or paste later is styled too. Match case and whole word follow the Highlighting page; the colours are Mark Style 1-5 in the Style Configurator.", -1, 12, 50, 436, 28
    LTEXT           "", IDC_K_INFO, 12, 86, 436, 9

    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END

IDD_KEX_PAGE_NOTE DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Quick note", -1, 4, 2, 452, 186
    AUTOCHECKBOX    "A global hotkey fades a small note in over any program", IDC_H_EN, 12, 15, 204, 10
    LTEXT           "", IDC_H_STATUS, 222, 16, 226, 9
    LTEXT           "Hotkey:", -1, 12, 33, 28, 8
    CONTROL         "", IDC_H_KEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 42, 31, 84, 12
    AUTOCHECKBOX    "+ Win", IDC_H_WIN, 132, 32, 34, 10
    LTEXT           "", IDC_H_KEYSTATUS, 170, 33, 278, 9
    AUTOCHECKBOX    "Line numbers", IDC_H_LINES, 12, 52, 140, 10
    AUTOCHECKBOX    "Wrap long lines", IDC_H_WRAP, 160, 52, 140, 10
    AUTOCHECKBOX    "Highlight the current line", IDC_H_CARETLINE, 308, 52, 140, 10
    AUTOCHECKBOX    "Fade in and out", IDC_H_FADE, 12, 67, 140, 10
    AUTOCHECKBOX    "Stay on top of other windows", IDC_H_ONTOP, 160, 67, 140, 10
    AUTOCHECKBOX    "Pinned: opens where I left it", IDC_H_PLACE, 308, 67, 140, 10
    AUTOCHECKBOX    "Keep the text between uses (saved as you type)", IDC_H_KEEP, 12, 82, 220, 10
    AUTOCHECKBOX    "Hide it when I click another window", IDC_H_AUTOHIDE, 308, 82, 140, 10
    LTEXT           "Note file:", -1, 12, 101, 34, 8
    EDITTEXT        IDC_H_FILE, 48, 99, 330, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_H_BROWSE, 384, 98, 62, 14
    LTEXT           "", IDC_H_FILEINFO, 48, 114, 400, 9
    LTEXT           "In the note:", -1, 12, 132, 42, 8
    AUTOCHECKBOX    "Smooth caret", IDC_H_CARET, 56, 131, 62, 10
    AUTOCHECKBOX    "Falling letters", IDC_H_LETTERS, 122, 131, 64, 10
    AUTOCHECKBOX    "Copy flash", IDC_H_FLASH, 190, 131, 116, 10
    LTEXT           "Opacity (%):", -1, 314, 132, 44, 8
    EDITTEXT        IDC_H_OPACITY, 360, 130, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Zoom in as it opens, out as it goes", IDC_H_ZOOM, 12, 146, 150, 10
    LTEXT           "Zoom speed (%):", -1, 170, 147, 58, 8
    EDITTEXT        IDC_H_ZOOMMS, 230, 145, 28, 12, ES_NUMBER
    LTEXT           "No title bar: drag the top strip to move it, the edges to resize it. The pin keeps it in place; pinned, it sends it back to the middle. Esc or the hotkey hides it and never hands the focus to another desktop. Ctrl+wheel zooms; Enter keeps the indentation.", -1, 12, 161, 436, 24

    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END

IDD_KEX_PAGE_EFFECTS DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Copy flash", -1, 4, 2, 452, 30
    AUTOCHECKBOX    "Copying lights the copied text up for a moment", IDC_E_EN, 12, 15, 196, 10
    LTEXT           "Light (%):", -1, 214, 16, 36, 8
    EDITTEXT        IDC_E_STRENGTH, 252, 14, 28, 12, ES_NUMBER
    LTEXT           "", IDC_E_STATUS, 290, 16, 158, 9

    GROUPBOX        "Tabs", -1, 4, 36, 452, 72
    AUTOCHECKBOX    "Switching tabs slides the new document in, like switching desktops", IDC_W_EN, 12, 48, 246, 10
    LTEXT           "", IDC_W_STATUS, 264, 49, 184, 9
    AUTOCHECKBOX    "A closed tab sinks into the bar and the tabs beside it close the gap", IDC_F_EN, 12, 61, 246, 10
    LTEXT           "", IDC_F_STATUS, 264, 62, 184, 9
    AUTOCHECKBOX    "Saving a file sends a glint across its tab and the top of the page", IDC_GL_EN, 12, 74, 246, 10
    LTEXT           "", IDC_GL_STATUS, 264, 75, 184, 9
    LTEXT           "Speed (%): slide", -1, 12, 91, 56, 8
    EDITTEXT        IDC_W_MS, 70, 89, 28, 12, ES_NUMBER
    LTEXT           "close and open", -1, 108, 91, 52, 8
    EDITTEXT        IDC_F_MS, 162, 89, 28, 12, ES_NUMBER
    LTEXT           "glint", -1, 200, 91, 18, 8
    EDITTEXT        IDC_GL_MS, 220, 89, 28, 12, ES_NUMBER

    GROUPBOX        "Paint splash", -1, 4, 112, 452, 30
    AUTOCHECKBOX    "Giving a token a colour splashes paint", IDC_P_EN, 12, 125, 160, 10
    LTEXT           "Drops:", -1, 178, 126, 24, 8
    EDITTEXT        IDC_P_DROPS, 204, 124, 26, 12, ES_NUMBER
    LTEXT           "", IDC_P_STATUS, 240, 126, 208, 9

    AUTOCHECKBOX    "Not when Windows animation effects are off (here and on the Motion page)", IDC_FX_RESPECT, 8, 148, 280, 10
    LTEXT           "", IDC_E_INFO, 4, 163, 452, 26
    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END

IDD_KEX_PAGE_MOTION DIALOGEX 115, 10, 460, 205
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Editing motion", -1, 4, 2, 452, 186
    AUTOCHECKBOX    "Edits move into place instead of jumping", IDC_M_EN, 12, 14, 200, 10
    LTEXT           "", IDC_M_STATUS, 220, 15, 228, 9
    LTEXT           "Each one on or off, and its speed (%):", -1, 12, 29, 300, 8
    AUTOCHECKBOX    "Cut: picked up, then gone", 2710, 12, 43, 168, 10
    EDITTEXT        2730, 184, 42, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Move lines (Ctrl+Shift+Up/Down)", 2715, 232, 43, 168, 10
    EDITTEXT        2735, 404, 42, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Delete in a line: wiped away", 2711, 12, 57, 168, 10
    EDITTEXT        2731, 184, 56, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Indent several lines (Tab)", 2717, 232, 57, 168, 10
    EDITTEXT        2737, 404, 56, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Delete across lines: fades out", 2712, 12, 71, 168, 10
    EDITTEXT        2732, 184, 70, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Fold and unfold", 2720, 232, 71, 168, 10
    EDITTEXT        2740, 404, 70, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Paste: makes room, lights up", 2713, 12, 85, 168, 10
    EDITTEXT        2733, 184, 84, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Sort lines", 2721, 232, 85, 168, 10
    EDITTEXT        2741, 404, 84, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Undo and redo", 2714, 12, 99, 168, 10
    EDITTEXT        2734, 184, 98, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Find: a ring on the match", 2716, 232, 99, 168, 10
    EDITTEXT        2736, 404, 98, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Duplicate a line (Ctrl+D)", 2718, 12, 113, 168, 10
    EDITTEXT        2738, 184, 112, 28, 12, ES_NUMBER
    AUTOCHECKBOX    "Go to a far line: the page slides", 2719, 232, 113, 168, 10
    EDITTEXT        2739, 404, 112, 28, 12, ES_NUMBER
    LTEXT           "New text's light, speed (%):", -1, 12, 130, 100, 8
    EDITTEXT        IDC_M_GLOW, 114, 128, 28, 12, ES_NUMBER
    LTEXT           "Editing fast: no motion within (ms):", -1, 156, 130, 124, 8
    EDITTEXT        IDC_M_RAPID, 282, 128, 28, 12, ES_NUMBER
    LTEXT           "of the last one", -1, 314, 130, 80, 8
    AUTOCHECKBOX    "In the quick note too", IDC_M_NOTE, 12, 146, 150, 10
    LTEXT           "Short, with no bounce, after Apple's guidance on motion. A motion stops the moment you type, edit or scroll, so it never holds you up, and edits that come quickly one after another show without one. Speeds: 100 % is as designed, 200 % twice as fast, 50 % half as fast (25 to 400); the speed for all animations is at the bottom.", -1, 12, 162, 436, 24
    LTEXT           "", IDC_SUMMARY, 4, 192, 452, 9
END
